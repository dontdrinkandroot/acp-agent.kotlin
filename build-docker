#!/bin/bash
set -euo pipefail

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)

resolve_docker_bin() {
    if [ -n "${DOCKER_BIN:-}" ]; then
        printf '%s\n' "$DOCKER_BIN"
        return 0
    fi
    if [ -x /usr/bin/docker ]; then
        printf '%s\n' /usr/bin/docker
    elif [ -x /usr/local/bin/docker ]; then
        printf '%s\n' /usr/local/bin/docker
    else
        command -v docker || true
    fi
}

docker_bin=$(resolve_docker_bin)
if [ -z "$docker_bin" ]; then
    printf '%s\n' 'Docker CLI not found. Set DOCKER_BIN to its absolute path.' >&2
    exit 127
fi

image=ghcr.io/dontdrinkandroot/acp-agent.kotlin:latest

# The build context has no .git (.dockerignore), so the commit hash the agent
# reports in its system prompt is injected here. The working tree state matches
# the context contents, so a non-clean tree is flagged.
git_sha=$(git -C "$script_dir" rev-parse --short HEAD 2>/dev/null || echo unknown)
if [ "$git_sha" != unknown ] && [ -n "$(git -C "$script_dir" status --porcelain 2>/dev/null)" ]; then
    git_sha="$git_sha-dirty"
fi

exec "$docker_bin" build --pull --build-arg "GIT_SHA=$git_sha" -t "$image" "$script_dir"