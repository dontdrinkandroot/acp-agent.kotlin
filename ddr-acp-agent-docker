#!/bin/bash
set -euo pipefail

# The masked .env.local file is removed on any exit path; cleanup must therefore
# survive being `exec`ed into docker, which is why the final command is a plain
# invocation.
cleanup() {
    [ -n "${env_local_mask_file:-}" ] && rm -f "$env_local_mask_file"
    return 0
}
trap cleanup EXIT

project_dir=$(pwd)
image=ghcr.io/dontdrinkandroot/acp-agent.kotlin:latest

container_home=/home/dev
container_cache_dir=$container_home/.cache
container_data_dir=$container_home/.local/share
# Host network by default: Gradle hands a cache lock to a waiting process only
# via a loopback UDP ping (issue #68), which never crosses network namespaces -
# a bridge-networked container times out after ~60s instead of handing over.
# With the host namespace the container also reaches host loopback services
# (MCP servers bound to 127.0.0.1) and the host's compose services directly.
# DDR_ACP_AGENT_DOCKER_NETWORK restores isolation (e.g. 'development' for
# compose DNS). These knobs follow the agent's naming scheme but are host-side
# only: the forwarding loop below carves them out of the agent env, and the
# legacy ACP_DOCKER_* spellings are not read at all.
network="${DDR_ACP_AGENT_DOCKER_NETWORK:-host}"
host_cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
host_data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
host_state_home="${XDG_STATE_HOME:-$HOME/.local/state}"

resolve_docker_bin() {
    if [ -n "${DOCKER_BIN:-}" ]; then
        printf '%s\n' "$DOCKER_BIN"
        return 0
    fi
    if [ -x /usr/bin/docker ]; then
        printf '%s\n' /usr/bin/docker
    elif [ -x /usr/local/bin/docker ]; then
        printf '%s\n' /usr/local/bin/docker
    else
        command -v docker || true
    fi
}

docker_bin=$(resolve_docker_bin)
if [ -z "$docker_bin" ]; then
    printf '%s\n' 'Docker CLI not found. Set DOCKER_BIN to its absolute path.' >&2
    exit 127
fi

# The API key is never handled by this launcher: it lives in the agent's config
# directory (~/.config/ddr-acp-agent/openrouter.key or the file named by
# openRouter.apiKeyFile) and travels in with that read-only mount. The agent
# resolves and validates it (owner-only, issue #50) and fails loudly at startup
# when there is none.

skip_pull=false
agent_args=()
for arg in "$@"; do
    if [ "$arg" = --skip-pull ]; then
        skip_pull=true
    else
        agent_args+=("$arg")
    fi
done

if [ "$skip_pull" = true ]; then
    if "$docker_bin" image inspect "$image" >/dev/null 2>&1; then
        printf 'skip-pull: using the locally available image %s.\n' "$image" >&2
    else
        printf 'Image %s not found locally; build it with ./build-docker or drop --skip-pull.\n' "$image" >&2
        exit 1
    fi
elif ! "$docker_bin" pull "$image" >&2; then
    if "$docker_bin" image inspect "$image" >/dev/null 2>&1; then
        printf 'WARNING: docker pull of %s failed (e.g. offline); continuing with the locally available image.\n' "$image" >&2
    else
        printf 'WARNING: docker pull of %s failed and no local image is available; build it with ./build-docker or retry once online.\n' "$image" >&2
        exit 1
    fi
fi

uid=$(id -u)
gid=$(id -g)

git_identity_env=()
if command -v git >/dev/null 2>&1; then
    author_name=$(git config user.name 2>/dev/null) || true
    author_email=$(git config user.email 2>/dev/null) || true
    if [ -n "$author_name" ] && [ -n "$author_email" ]; then
        printf 'Forwarding host git identity: %s <%s>\n' "$author_name" "$author_email" >&2
        git_identity_env=(
            --env "GIT_AUTHOR_NAME=$author_name"
            --env "GIT_AUTHOR_EMAIL=$author_email"
            --env "GIT_COMMITTER_NAME=$author_name"
            --env "GIT_COMMITTER_EMAIL=$author_email"
        )
    fi
fi

env_local_mounts=()
env_local_mask_file=
if [ -f "$project_dir/.env.local" ]; then
    env_local_mask_file=$(mktemp)
    printf 'Masking %s/.env.local (mounted over with an empty read-only file).\n' "$project_dir" >&2
    env_local_mounts=(--mount "type=bind,src=$env_local_mask_file,dst=$project_dir/.env.local,ro")
fi

cache_mounts=()
cache_env_overrides=()
gradle_version_args=()
mounted_dsts=" "
mounted_caches=

# Shares one host tool cache with the container (issue #51). Two cases:
# - Explicitly configured (the tool's env var is set): the host dir is
#   identity-bound at the identical in-container path and the env value is
#   forwarded verbatim - the tool's own configuration already points at the
#   right path, and host-created symlinks into the cache keep resolving.
#   Config that cannot be honored (relative path, /, uncreatable dir) fails
#   loudly before any docker run instead of silently falling back.
# - Default fallback (env var unset): the first existing candidate is mounted
#   at the tool's in-container default and the env var is pinned to that dst
#   (the container home differs from the host home, so relocation stays
#   necessary there).
add_tool_cache() {
    local label=$1 dst=$2 env_name=$3
    local -a candidates=("${@:4}")
    local host_dir='' explicit=false env_value=''
    if [ -n "$env_name" ]; then
        env_value=${!env_name:-}
        if [ -n "$env_value" ]; then
            explicit=true
            host_dir=$env_value
            case "$host_dir" in
                /*) ;;
                *)
                    printf '%s: %s is not an absolute host path.\n' "$env_name" "$host_dir" >&2
                    exit 1
                    ;;
            esac
            # Mount paths are slash-normalized (the env value stays verbatim).
            while [ "${host_dir%/}" != "$host_dir" ]; do
                host_dir=${host_dir%/}
            done
            if [ -z "$host_dir" ]; then
                printf '%s: / cannot be used as a cache directory.\n' "$env_name" >&2
                exit 1
            fi
            # An explicitly configured dir is created if missing (docker bind
            # mounts need an existing source); a dir that cannot be created is
            # config we cannot honor and fails loudly.
            if [ ! -d "$host_dir" ] && ! mkdir -p "$host_dir" 2>/dev/null; then
                printf '%s: %s could not be created on the host.\n' "$env_name" "$host_dir" >&2
                exit 1
            fi
        fi
    fi
    if [ -z "$host_dir" ]; then
        # Fallback: only an already existing host default dir is shared - never
        # created (the tool then keeps its ephemeral in-container default).
        for candidate in "${candidates[@]}"; do
            if [ -d "$candidate" ]; then
                host_dir=$candidate
                break
            fi
        done
    fi
    if [ -z "$host_dir" ] || [ "$host_dir" = / ]; then
        return 0
    fi
    local mount_dst=$dst
    if [ "$explicit" = true ]; then
        mount_dst=$host_dir
    fi
    local do_mount=true
    case "$host_dir" in
        "$project_dir"|"$project_dir"/*) do_mount=false ;;
    esac
    case "$mounted_dsts" in
        *" $mount_dst "*) do_mount=false ;;
    esac
    if [ "$do_mount" = true ]; then
        cache_mounts+=(--mount "type=bind,src=$host_dir,dst=$mount_dst")
        mounted_dsts="$mounted_dsts $mount_dst "
        mounted_caches="$mounted_caches $label($host_dir)"
    fi
    if [ "$explicit" = true ]; then
        # The configured value is forwarded verbatim even when the mount is
        # skipped: an in-project dir is covered by the project mount at the
        # identical path, a deduped dst is already mounted - but the tool must
        # still honor the configured path (issue #51).
        cache_env_overrides+=(--env "$env_name=$env_value")
    elif [ -n "$env_name" ] && [ "$do_mount" = true ]; then
        # Pin the tool to the mounted dir inside the container: the dst is the
        # tool's in-container default, so the value matches for existing tools.
        cache_env_overrides+=(--env "$env_name=$mount_dst")
    fi
}

if [ "${DDR_ACP_AGENT_DOCKER_MOUNT_CACHES:-1}" != 0 ]; then
    # The Android SDK is shared from the host (see the cache mounts below). A
    # set but unusable ANDROID_HOME/ANDROID_SDK_ROOT (relative path, missing
    # directory, /) would bind-mount a nonexistent source or resolve a
    # relative path inside the container - fail loudly before any docker run.
    # The first one set wins; ANDROID_HOME is the name Android tooling
    # prefers. Under DDR_ACP_AGENT_DOCKER_MOUNT_CACHES=0 the whole cache/SDK config is
    # ignored wholesale - not even validated (issue #51).
    android_sdk_env=
    android_sdk_dir=
    if [ -n "${ANDROID_HOME:-}" ]; then
        android_sdk_env=ANDROID_HOME
        android_sdk_dir=$ANDROID_HOME
    elif [ -n "${ANDROID_SDK_ROOT:-}" ]; then
        android_sdk_env=ANDROID_SDK_ROOT
        android_sdk_dir=$ANDROID_SDK_ROOT
    fi
    if [ -n "$android_sdk_dir" ]; then
        case $android_sdk_dir in
            /*) ;;
            *)
                printf '%s\n' "$android_sdk_env: $android_sdk_dir is not an absolute host path." >&2
                exit 1
                ;;
        esac
        if [ "$android_sdk_dir" = / ]; then
            printf '%s\n' "$android_sdk_env: / cannot be the Android SDK directory." >&2
            exit 1
        fi
        if [ ! -d "$android_sdk_dir" ]; then
            printf '%s\n' "$android_sdk_env: $android_sdk_dir is not a directory on the host." >&2
            exit 1
        fi
    fi
    add_tool_cache uv "$container_cache_dir/uv" UV_CACHE_DIR "$host_cache_home/uv"
    add_tool_cache pip "$container_cache_dir/pip" PIP_CACHE_DIR "$host_cache_home/pip"
    add_tool_cache composer "$container_cache_dir/composer" COMPOSER_CACHE_DIR "$host_cache_home/composer"
    add_tool_cache yarn "$container_cache_dir/yarn" YARN_CACHE_FOLDER "$host_cache_home/yarn"
    add_tool_cache huggingface "$container_cache_dir/huggingface" HF_HOME "$host_cache_home/huggingface"
    add_tool_cache npm "$container_home/.npm" NPM_CONFIG_CACHE "$HOME/.npm"
    add_tool_cache maven "$container_home/.m2" "" "$HOME/.m2"
    add_tool_cache cargo "$container_home/.cargo" CARGO_HOME "$HOME/.cargo"
    add_tool_cache go "$container_home/go/pkg/mod" GOMODCACHE "$HOME/go/pkg/mod"
    add_tool_cache nuget "$container_home/.nuget/packages" NUGET_PACKAGES "$HOME/.nuget/packages"
    add_tool_cache pub "$container_home/.pub-cache" PUB_CACHE "$HOME/.pub-cache"
    # pnpm exposes its config as pnpm_config_*/PNPM_CONFIG_* env vars
    # (pnpm.io/configuring), so the store/cache dirs go through the standard
    # explicit-config policy like every other tool cache (issue #51 follow-up).
    add_tool_cache pnpm-store "$container_data_dir/pnpm/store" PNPM_CONFIG_STORE_DIR "$host_data_home/pnpm/store"
    add_tool_cache pnpm-cache "$container_cache_dir/pnpm" PNPM_CONFIG_CACHE_DIR "$host_cache_home/pnpm"
    add_tool_cache konan "$container_home/.konan" KONAN_DATA_DIR "$HOME/.konan"
    # The Gradle user home is NOT shared as a whole (that would merge the
    # daemon registry + logs across the host and container PID namespaces:
    # probing clients remove unreachable entries and gradle --stop kills
    # daemons of both environments). The GUH root stays container-private
    # (uid-mapped .gradle tmpfs, see gradle_args below) for daemon/, .tmp,
    # kotlin/ and native/.
    # Everything Gradle documents as a *cache* (docs: directory_layout,
    # "Shared caches" / "Version-specific caches") is content-addressed or
    # deterministic per distribution and is shared rw at its in-container
    # path, so downloads and transform output persist on the host and are
    # shared with host builds (issue #67):
    #   caches/modules-2                downloaded dependencies (relative-path encoded, copyable)
    #   caches/jars-*                   instrumented classpath jars
    #   caches/build-cache-*            local build cache (task outputs keyed by input hashes)
    #   caches/transforms-*             legacy cross-version transform output (Gradle < 8.9)
    #   caches/<ver>/transforms         version-bound transform output (AGP dex/resources)
    #   caches/<ver>/generated-gradle-jars  deterministic per distribution
    #   wrapper/dists                   wrapper distributions
    #   jdks                            provisioned toolchain JDKs
    # Everything else stays on the private tmpfs: execution state keyed by
    # absolute paths (journal-1/file-access.bin, caches/<ver>/fileHashes,
    # jvms), JVM-sensitive compiled scripts (kotlin-dsl, scripts) and
    # caches/<ver>/cc-keystore - the configuration-cache encryption key,
    # which must never leave the container (sharing it would let the sandbox
    # decrypt the host's configuration-cache entries).
    # The env pin below makes GRADLE_USER_HOME explicit (and the mount sources
    # are resolved against the host GUH), independent of the base image's
    # default. Sources are created on first run like every other tool cache;
    # the ./gradle or ./caches siblings (native/, kotlin/, journal-1) stay on
    # the private tmpfs.
    gradle_guh=${GRADLE_USER_HOME:-}
    case "$gradle_guh" in
        /*) ;;
        *) gradle_guh= ;;
    esac
    if [ -z "$gradle_guh" ] && [ -d "$HOME/.gradle" ]; then
        gradle_guh=$HOME/.gradle
    fi
    if [ -n "$gradle_guh" ] && [ "$gradle_guh" != / ]; then
        case "$gradle_guh" in
            "$project_dir"|"$project_dir"/*) gradle_guh= ;;
        esac
    fi
    if [ -n "$gradle_guh" ]; then
        mkdir -p "$gradle_guh/caches/modules-2" \
            "$gradle_guh/caches/jars-9" \
            "$gradle_guh/caches/build-cache-1" \
            "$gradle_guh/wrapper/dists" \
            "$gradle_guh/jdks" 2>/dev/null || true
        # Content-addressed leaves; matches Gradle's own cache taxonomy
        # (docs: directory_layout, "Shared caches"): modules-2, jars-N,
        # build-cache-N and the legacy cross-version transforms-N. The
        # trailing format number varies per Gradle generation - mount the
        # globs via loops over the existing host dirs (mkdir creates the
        # current-format names so the globs always have a match).
        local_cache_dirs=()
        for dir in "$gradle_guh"/caches/jars-* "$gradle_guh"/caches/build-cache-* \
                    "$gradle_guh"/caches/transforms-*; do
            [ -d "$dir" ] && local_cache_dirs+=("$dir")
        done
        for leaf in "$gradle_guh/caches/modules-2" "${local_cache_dirs[@]}" \
                    "$gradle_guh/wrapper/dists" "$gradle_guh/jdks"; do
            [ -d "$leaf" ] || continue
            gradle_dst=$container_home/.gradle/${leaf#"$gradle_guh"/}
            case "$mounted_dsts" in
                *" $gradle_dst "*) continue ;;
            esac
            cache_mounts+=(--mount "type=bind,src=$leaf,dst=$gradle_dst")
            mounted_dsts="$mounted_dsts $gradle_dst "
            mounted_caches="$mounted_caches gradle($leaf)"
        done
        # Version-bound caches (caches/<ver>/): each version dir gets its own
        # uid-mapped tmpfs for the private siblings (fileHashes, kotlin-dsl,
        # cc-keystore) and binds for the two shared children on top. Version
        # names come from the digit-named caches dirs (9.6.0,
        # 8.0-milestone-1, ...) plus the shared wrapper dists
        # (gradle-<version>-<bin|all>) - the latter covers a wrapper upgrade
        # whose caches/<ver> dir the host has not created yet, which would
        # otherwise re-derive generated-gradle-jars + transforms into the
        # tmpfs every session.
        gradle_version_dirs=()
        gradle_version_seen=" "
        add_gradle_version() {
            case "$gradle_version_seen" in
                *" $1 "*) return 0 ;;
            esac
            gradle_version_seen="$gradle_version_seen$1 "
            gradle_version_dirs+=("$1")
        }
        for vdir in "$gradle_guh"/caches/[0-9]*; do
            [ -d "$vdir" ] || continue
            add_gradle_version "${vdir##*/}"
        done
        for dist in "$gradle_guh"/wrapper/dists/gradle-[0-9]*; do
            [ -d "$dist" ] || continue
            name=${dist##*/}
            name=${name#gradle-}
            name=${name%-bin}
            name=${name%-all}
            [ -n "$name" ] && add_gradle_version "$name"
        done
        for ver in "${gradle_version_dirs[@]}"; do
            vdir=$gradle_guh/caches/$ver
            mkdir -p "$vdir/transforms" "$vdir/generated-gradle-jars" 2>/dev/null || true
            for leaf in "$vdir/transforms" "$vdir/generated-gradle-jars"; do
                [ -d "$leaf" ] || continue
                gradle_dst=$container_home/.gradle/caches/$ver/${leaf##*/}
                case "$mounted_dsts" in
                    *" $gradle_dst "*) continue ;;
                esac
                cache_mounts+=(--mount "type=bind,src=$leaf,dst=$gradle_dst")
                mounted_dsts="$mounted_dsts $gradle_dst "
                mounted_caches="$mounted_caches gradle($leaf)"
            done
            gradle_version_args+=(--tmpfs "$container_home/.gradle/caches/$ver:uid=$uid,gid=$gid,mode=700,size=1g,exec")
        done
    fi
    # The host Android SDK (validated above when explicitly configured): an
    # explicit ANDROID_HOME/ANDROID_SDK_ROOT is identity-bound at the
    # identical in-container path and both ANDROID_* variables carry the
    # configured value (the set one is authoritative - ANDROID_HOME wins over
    # ANDROID_SDK_ROOT - its companion is synthesized to the same value).
    # The default candidate ($HOME/Android/Sdk, never created) keeps the
    # relocation to the SDK's in-container default with both variables pinned
    # to it. When the SDK lies inside the project dir the mount is skipped
    # (the project is already mounted rw at the identical path) and the
    # variables keep the configured path (issue #51).
    if [ -n "$android_sdk_dir" ]; then
        android_sdk_mount=${android_sdk_dir%/}
        case "$android_sdk_mount" in
            "$project_dir"|"$project_dir"/*) ;;
            *)
                case "$mounted_dsts" in
                    *" $android_sdk_mount "*) ;;
                    *)
                        cache_mounts+=(--mount "type=bind,src=$android_sdk_mount,dst=$android_sdk_mount")
                        mounted_dsts="$mounted_dsts $android_sdk_mount "
                        mounted_caches="$mounted_caches android-sdk($android_sdk_mount)"
                        ;;
                esac
                ;;
        esac
        cache_env_overrides+=(--env "ANDROID_HOME=$android_sdk_dir")
        cache_env_overrides+=(--env "ANDROID_SDK_ROOT=$android_sdk_dir")
    elif [ -d "$HOME/Android/Sdk" ]; then
        # A default-candidate SDK inside the project dir is covered by the
        # project mount at the identical path - skip the relocation and keep
        # the tool's own default (the unchanged tool-cache skip policy).
        android_sdk_dst=$container_home/Android/Sdk
        case "$HOME/Android/Sdk" in
            "$project_dir"|"$project_dir"/*) ;;
            *)
                case "$mounted_dsts" in
                    *" $android_sdk_dst "*) ;;
                    *)
                        cache_mounts+=(--mount "type=bind,src=$HOME/Android/Sdk,dst=$android_sdk_dst")
                        mounted_dsts="$mounted_dsts $android_sdk_dst "
                        mounted_caches="$mounted_caches android-sdk($HOME/Android/Sdk)"
                        cache_env_overrides+=(--env "ANDROID_HOME=$android_sdk_dst")
                        cache_env_overrides+=(--env "ANDROID_SDK_ROOT=$android_sdk_dst")
                        ;;
                esac
                ;;
        esac
    fi
    # Host uv link-mode config travels with the shared caches: hosts set
    # UV_LINK_MODE=symlink for cross-device cache layouts (cache on a
    # different filesystem than the venvs), which are identical in the
    # container once the cache is identity-bound (issue #51).
    if [ -n "${UV_LINK_MODE:-}" ]; then
        cache_env_overrides+=(--env "UV_LINK_MODE=$UV_LINK_MODE")
    fi
    # Same for pnpm's enable-global-virtual-store config: node_modules then
    # symlinks into the shared store, so host and container projects only
    # share one layout when the setting travels with the identity-bound
    # store/cache dirs above (pnpm config via PNPM_CONFIG_* env vars).
    if [ -n "${PNPM_CONFIG_ENABLE_GLOBAL_VIRTUAL_STORE:-}" ]; then
        cache_env_overrides+=(
            --env "PNPM_CONFIG_ENABLE_GLOBAL_VIRTUAL_STORE=$PNPM_CONFIG_ENABLE_GLOBAL_VIRTUAL_STORE")
    fi
    if [ -n "$mounted_caches" ]; then
        printf 'Mounting host caches:%s\n' "$mounted_caches" >&2
    fi
fi

# Session state is always persisted on the host so conversations survive the
# ephemeral tmpfs home. The host side mirrors container XDG_STATE_HOME, so
# agent-side session/persist writes land in ~/.local/state/ddr-acp-agent.
# DDR_ACP_AGENT_DOCKER_STATE_DIR relocates the host side (e.g. out of an fscrypt v1
# encrypted home, whose key no container can access: writes would fail with
# "Required key not available").
state_mounts=()
state_host_dir=${DDR_ACP_AGENT_DOCKER_STATE_DIR:-$host_state_home/ddr-acp-agent}
case "$state_host_dir" in
    /*) ;;
    *) state_host_dir=$host_state_home/ddr-acp-agent ;;
esac
if [ -n "$state_host_dir" ] && [ "$state_host_dir" != / ] &&
   [[ "$state_host_dir" != "$project_dir" && "$state_host_dir" != "$project_dir"/* ]] &&
   ! [[ " $mounted_dsts " == *" $container_home/.local/state/ddr-acp-agent "* ]]; then
    mkdir -p "$state_host_dir" 2>/dev/null || true
    state_mounts=(--mount "type=bind,src=$state_host_dir,dst=$container_home/.local/state/ddr-acp-agent")
fi
if [ ${#state_mounts[@]} -gt 0 ]; then
    printf 'Mounting session state: %s\n' "$state_host_dir" >&2
fi

# The agent's config directory ($XDG_CONFIG_HOME/ddr-acp-agent, issue #50):
# config.json and the default openrouter.key live there, and the container home
# is an ephemeral tmpfs, so the host directory is mounted at the container's own
# config directory. A missing host directory is fine - the agent then runs on
# built-in defaults. A host-configured DDR_ACP_AGENT_CONFIG_FILE is a bare file
# name and is forwarded verbatim, so it resolves inside this mount.
host_config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
config_host_dir=$host_config_home/ddr-acp-agent
config_mounts=()
if [ -d "$config_host_dir" ] &&
   [[ "$config_host_dir" != "$project_dir" && "$config_host_dir" != "$project_dir"/* ]] &&
   ! [[ " $mounted_dsts " == *" $container_home/.config/ddr-acp-agent "* ]]; then
    config_mounts=(--mount "type=bind,src=$config_host_dir,dst=$container_home/.config/ddr-acp-agent,ro")
    printf 'Mounting agent config: %s\n' "$config_host_dir" >&2
fi

# The permission directory lists ARE the mount list (issue #50): a path is
# mounted exactly because the agent is allowed to use it, and the mount mode is
# the tier - readable mounts read-only, writable mounts read-write. One list,
# two consumers, so the trust domain and the mounts can never drift apart.
#
#   DDR_ACP_AGENT_PERMISSIONS_READABLE_DIRECTORIES=/srv/data,/mnt/scratch
#   DDR_ACP_AGENT_PERMISSIONS_WRITABLE_DIRECTORIES=/srv/scratch
#
# Paths are mounted at the identical in-container path. The variables are
# forwarded to the agent unchanged (prefix loop below), so it trusts exactly
# what is mounted. `config.json`'s `permissions.*` are therefore a direct-run
# concern: a host-side entry the launcher cannot mount must not be trusted
# inside the container, which is why the env layer overrides the file layer.
#
# Mounts are emitted before every built-in mount and sorted shallowest-first,
# so built-ins and deeper mounts shadow shallower ones (docker applies the last
# mount at a path on top).
permission_mount_args=()
if [ -n "${DDR_ACP_AGENT_PERMISSIONS_READABLE_DIRECTORIES:-}" ] ||
   [ -n "${DDR_ACP_AGENT_PERMISSIONS_WRITABLE_DIRECTORIES:-}" ]; then
    # "path|mode" pairs, kept in input order; a path listed in both tiers is
    # mounted rw once (writable wins).
    permission_entries=()
    mount_fail=false
    for tier in read write; do
        if [ "$tier" = read ]; then
            list=${DDR_ACP_AGENT_PERMISSIONS_READABLE_DIRECTORIES:-}
            tier_label=READABLE
            mode=ro
        else
            list=${DDR_ACP_AGENT_PERMISSIONS_WRITABLE_DIRECTORIES:-}
            tier_label=WRITABLE
            mode=rw
        fi
        [ -n "$list" ] || continue
        IFS=',' read -ra entries <<<"$list"
        for path in "${entries[@]}"; do
            path=$(printf '%s' "$path" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
            [ -n "$path" ] || continue
            case $path in
                /*) ;;
                *)
                    printf 'DDR_ACP_AGENT_PERMISSIONS_%s_DIRECTORIES: %s is not an absolute host path.\n' \
                        "$tier_label" "$path" >&2
                    mount_fail=true
                    continue
                    ;;
            esac
            if [ "$path" = / ]; then
                printf 'DDR_ACP_AGENT_PERMISSIONS_%s_DIRECTORIES: / cannot be mounted.\n' "$tier_label" >&2
                mount_fail=true
                continue
            fi
            # Covered paths are shadowed by the covering mount at the identical
            # path - skipped with a warning regardless of host existence. Host
            # existence is only validated for paths that actually get mounted.
            case $path in
                "$project_dir"|"$project_dir"/*)
                    printf 'Permissions: skipping %s - inside the project directory, which is always mounted rw.\n' "$path" >&2
                    continue
                    ;;
                "$container_home"|"$container_home"/*)
                    printf 'Permissions: skipping %s - covered by the container home.\n' "$path" >&2
                    continue
                    ;;
                /tmp|/tmp/*)
                    printf 'Permissions: skipping %s - covered by the container tmpfs.\n' "$path" >&2
                    continue
                    ;;
            esac
            if [ ! -e "$path" ]; then
                printf 'Permissions: %s does not exist on the host.\n' "$path" >&2
                mount_fail=true
                continue
            fi
            if [ "$mode" = rw ]; then
                # Drop a previous read-only entry for the same path, then add rw.
                remaining=()
                for entry in "${permission_entries[@]}"; do
                    [ "${entry%%|*}" = "$path" ] || remaining+=("$entry")
                done
                permission_entries=("${remaining[@]}" "$path|rw")
            else
                duplicate=false
                for entry in "${permission_entries[@]}"; do
                    [ "${entry%%|*}" = "$path" ] && duplicate=true
                done
                [ "$duplicate" = true ] || permission_entries+=("$path|ro")
            fi
        done
    done
    if [ "$mount_fail" = true ]; then
        exit 1
    fi
    if [ ${#permission_entries[@]} -gt 0 ]; then
        mounted_permissions=
        while IFS=$'\t' read -r path; do
            [ -n "$path" ] || continue
            for entry in "${permission_entries[@]}"; do
                [ "${entry%%|*}" = "$path" ] || continue
                mode=${entry##*|}
                if [ "$mode" = ro ]; then
                    permission_mount_args+=(--mount "type=bind,src=$path,dst=$path,ro")
                else
                    permission_mount_args+=(--mount "type=bind,src=$path,dst=$path")
                fi
                mounted_permissions="$mounted_permissions $path($mode)"
            done
        done < <(for entry in "${permission_entries[@]}"; do
                     printf '%s\t%s\n' "$(printf '%s' "${entry%%|*}" | tr -cd / | wc -c)" "${entry%%|*}"
                 done | LC_ALL=C sort -t "$(printf '\t')" -k1,1n -s | cut -f2)
        printf 'Mounting permission directories:%s\n' "$mounted_permissions" >&2
    fi
fi

forwarded_env=()
# TZ keeps the container's wall clock on the host's zone: the agent renders
# local-offset timestamps (session/list updatedAt, issue #22) and a read-only
# rootfs means there is no /etc/localtime to fall back on.
# DDR_ACP_AGENT_SCRATCH_DIR is forwarded verbatim and never mounted: its value
# is a *container* path (the agent creates and verifies it itself). Pointing it
# at a host path is meaningless here - the container's /tmp is a private tmpfs,
# so scratch content does not outlive the container. No runtime check: the
# agent fails session creation loudly if the path cannot be created/verified.
# The whole DDR_ACP_AGENT_* family (issue #50) is forwarded as a single prefix
# family, so a new agent config option needs no launcher change. A config-file
# *name* therefore travels verbatim and resolves inside the mounted config
# directory - that is exactly why it is a name and not a path.
# The launcher's own knobs (DDR_ACP_AGENT_DOCKER_*) are carved out of that
# family explicitly: they are host-side decisions (network mode, state dir,
# cache sharing, ...) that mean nothing inside the container, and silently
# handing them to the agent would let a host-only value look like agent config.
# Agent config values that name a *host* path are not special-cased: the
# permissions lists are the mount list (see above), and a key file outside the
# config directory is not mounted, so point
# DDR_ACP_AGENT_OPEN_ROUTER_API_KEY_FILE at the config directory.
for var_name in TZ $(compgen -e | grep -E '^DDR_ACP_AGENT_' | grep -v -E '^DDR_ACP_AGENT_DOCKER_'); do
    if [ -n "${!var_name:-}" ]; then
        forwarded_env+=(--env "$var_name=${!var_name}")
    fi
done
# GRADLE_USER_HOME is always pinned to the container-private .gradle root
# (tmpfs): the host value must never leak in, and Gradle must resolve its
# daemon/process state to the private tmpfs regardless of the base image's
# default and of DDR_ACP_AGENT_DOCKER_MOUNT_CACHES (which only gates the shared leaf
# binds, see the gradle leaf mounts above).
forwarded_env+=(--env "GRADLE_USER_HOME=$container_home/.gradle")

rootfs_args=(--read-only)
if [ "${DDR_ACP_AGENT_DOCKER_RW_ROOTFS:-}" = 1 ]; then
    rootfs_args=()
fi

cap_add_args=()
if [ -n "${DDR_ACP_AGENT_DOCKER_CAP_ADD:-}" ]; then
    IFS=',' read -ra caps <<<"${DDR_ACP_AGENT_DOCKER_CAP_ADD}"
    for cap in "${caps[@]}"; do
        cap=${cap//[[:space:]]/}
        if [ -n "$cap" ]; then
            cap_add_args+=(--cap-add "$cap")
        fi
    done
fi

if [ -n "${DDR_ACP_AGENT_DOCKER_HOME_VOLUME:-}" ]; then
    home_args=(--mount "type=volume,src=$DDR_ACP_AGENT_DOCKER_HOME_VOLUME,dst=$container_home")
else
    # exec is required: toolchains execute native binaries extracted into
    # $HOME (Kotlin/Native under ~/.konan, AGP's AAPT2 from Maven under
    # ~/.gradle) - docker's --tmpfs defaults include noexec, which surfaced
    # as "AAPT2 ... Daemon startup failed" (see issue #33).
    home_args=(--tmpfs "$container_home:uid=$uid,gid=$gid,mode=700,size=1g,exec")
fi

cache_args=(--tmpfs "$container_cache_dir:uid=$uid,gid=$gid,mode=700,size=1g")

# The Gradle user home root is a container-private uid-mapped tmpfs (same
# treatment as ~/.local): it holds daemon/, .tmp, kotlin/, native/ and the
# per-version caches/<ver>/ state, which must never be shared with the host
# (see the gradle leaf mounts above). The shared content-addressed leaf binds
# land on top of this tmpfs; daemon state is therefore always ephemeral per
# container session, and the tmpfs stays even under DDR_ACP_AGENT_DOCKER_MOUNT_CACHES=0
# (like the ~/.cache and ~/.local tmpfs mounts). The caches/ and wrapper/
# intermediate depths get their own per-depth uid-mapped tmpfs for the same
# reason the ~/.local depths do: runc creates the missing parents of the
# content-addressed bind-mountpoints (caches/modules-2, caches/jars-*,
# wrapper/dists) root-owned inside the root tmpfs, and Gradle must be able to
# write new children of caches/ (versioned caches/<ver>/ metadata, jvms/) and
# wrapper/ - which stay on the private tmpfs, not the host binds. exec is
# required on the Gradle depths: AGP extracts AAPT2 from Maven into the
# versioned caches/<ver>/ (a transform output dir) and executes it from there;
# under docker's noexec tmpfs default that surfaced as "AAPT2 ... Daemon
# startup failed" (see issue #33). The host bind leaves never restricted exec.
gradle_args=(
    --tmpfs "$container_home/.gradle:uid=$uid,gid=$gid,mode=700,size=1g,exec"
    --tmpfs "$container_home/.gradle/caches:uid=$uid,gid=$gid,mode=700,size=1g,exec"
    --tmpfs "$container_home/.gradle/wrapper:uid=$uid,gid=$gid,mode=700,size=1g,exec"
)

# ~/.local is covered by tmpfs mounts: runc creates missing bind-mount
# mountpoints root-owned inside the container, so the deep session-state and
# pnpm-store binds would otherwise leave a root-owned ~/.local behind that the
# agent's uid cannot create files in (the image has no ~/.local, and the home
# tmpfs shadows image content anyway). The state/store binds land on top of
# these tmpfs mounts: moby composes all mounts into the OCI spec sorted
# shallowest-first, and runc mounts in that order regardless of the CLI argv
# order. Mirrors the ~/.cache treatment above; same 1g bound as every other
# container tmpfs (lazily allocated, spill to swap allowed).
local_args=(
    --tmpfs "$container_home/.local:uid=$uid,gid=$gid,mode=700,size=1g"
    --tmpfs "$container_home/.local/share:uid=$uid,gid=$gid,mode=700,size=1g"
    --tmpfs "$container_home/.local/state:uid=$uid,gid=$gid,mode=700,size=1g"
)

# ~/.config gets the same treatment as ~/.local: the config bind mount is a
# child of it ($container_home/.config/ddr-acp-agent), and runc would create the
# missing parent root-owned inside the container, leaving it unwritable.
if [ ${#config_mounts[@]} -gt 0 ]; then
    config_home_args=(--tmpfs "$container_home/.config:uid=$uid,gid=$gid,mode=700,size=64m")
else
    config_home_args=()
fi

extra_args=()
if [ -n "${DDR_ACP_AGENT_DOCKER_EXTRA_ARGS:-}" ]; then
    IFS=' ' read -ra extra_args <<<"${DDR_ACP_AGENT_DOCKER_EXTRA_ARGS}"
fi

# Not exec'd: the EXIT trap must run after docker returns to remove the
# .env.local mask file.
# --add-host=host.docker.internal:...: plain Linux docker daemons do not
# resolve host.docker.internal, so the mapping lets the container reach MCP
# servers running on the host (e.g. the PhpStorm MCP server at
# http://host.docker.internal:<port>/sse). In host network mode the host's
# loopback IS the container's loopback, so 127.0.0.1 is the correct target
# (host-gateway would name the bridge gateway, which misses 127.0.0.1-bound
# services); on an explicit network the bridge gateway is.
if [ "$network" = host ]; then
    host_docker_internal_target=127.0.0.1
else
    host_docker_internal_target=host-gateway
fi
"$docker_bin" run --rm --init -i \
    --network "$network" \
    --add-host="host.docker.internal:$host_docker_internal_target" \
    --user "$uid:$gid" \
    "${permission_mount_args[@]}" \
    --workdir "$project_dir" \
    --mount "type=bind,src=$project_dir,dst=$project_dir" \
    "${env_local_mounts[@]}" \
    "${home_args[@]}" \
    "${gradle_args[@]}" \
    "${gradle_version_args[@]}" \
    "${cache_args[@]}" \
    "${local_args[@]}" \
    "${cache_mounts[@]}" \
    "${state_mounts[@]}" \
    "${config_home_args[@]}" \
    "${config_mounts[@]}" \
    "${rootfs_args[@]}" \
    --cap-drop=ALL \
    "${cap_add_args[@]}" \
    --security-opt no-new-privileges \
    --tmpfs /tmp:rw,nosuid,nodev,exec,size=1g \
    "${git_identity_env[@]}" \
    "${forwarded_env[@]}" \
    "${cache_env_overrides[@]}" \
    --env "HOME=$container_home" \
    --env "TERM=${TERM:-}" \
    --env "XDG_CONFIG_HOME=$container_home/.config" \
    --env "XDG_DATA_HOME=$container_home/.local/share" \
    --env "XDG_STATE_HOME=$container_home/.local/state" \
    --env "XDG_CACHE_HOME=$container_home/.cache" \
    "${extra_args[@]}" \
    "$image" \
    "${agent_args[@]}"
