#!/bin/bash
set -euo pipefail

# Temporary files created by this launcher (masked .env.local, staged API key)
# are removed on any exit path; cleanup must therefore survive being `exec`ed
# into docker, which is why the final command is a plain invocation.
cleanup() {
    [ -n "${env_local_mask_file:-}" ] && rm -f "$env_local_mask_file"
    [ -n "${api_key_stage_file:-}" ] && rm -f "$api_key_stage_file"
    return 0
}
trap cleanup EXIT

project_dir=$(pwd)
image=ghcr.io/dontdrinkandroot/acp-agent.kotlin:latest

container_home=/home/dev
container_cache_dir=$container_home/.cache
container_data_dir=$container_home/.local/share
network="${ACP_DOCKER_NETWORK:-development}"
host_cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
host_data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
host_state_home="${XDG_STATE_HOME:-$HOME/.local/state}"

resolve_docker_bin() {
    if [ -n "${DOCKER_BIN:-}" ]; then
        printf '%s\n' "$DOCKER_BIN"
        return 0
    fi
    if [ -x /usr/bin/docker ]; then
        printf '%s\n' /usr/bin/docker
    elif [ -x /usr/local/bin/docker ]; then
        printf '%s\n' /usr/local/bin/docker
    else
        command -v docker || true
    fi
}

docker_bin=$(resolve_docker_bin)
if [ -z "$docker_bin" ]; then
    printf '%s\n' 'Docker CLI not found. Set DOCKER_BIN to its absolute path.' >&2
    exit 127
fi

# The API key must never travel through the environment (a leaked `set -x`
# trace, `env` dump or /proc/*/environ read inside the agent sandbox would
# disclose it). It is handed to the container as a read-only file at
# /tmp/openrouter-api-key and the agent env only carries the path:
# - OPENROUTER_API_KEY set  -> a 0600 copy is staged in /dev/shm, mounted, and
#   removed by the EXIT trap (the host env never becomes the container's).
# - OPENROUTER_API_KEY_FILE set -> that host file is mounted directly.
api_key_mounts=()
api_key_stage_file=
if [ -n "${OPENROUTER_API_KEY:-}" ] && [ -n "${OPENROUTER_API_KEY_FILE:-}" ]; then
    printf '%s\n' 'Set either OPENROUTER_API_KEY or OPENROUTER_API_KEY_FILE, not both.' >&2
    exit 1
fi
if [ -n "${OPENROUTER_API_KEY:-}" ]; then
    # /dev/shm is tmpfs-backed on every docker host; fall back to /tmp there.
    api_key_stage_file=$(mktemp /dev/shm/openrouter-api-key.XXXXXX 2>/dev/null ||
        mktemp /tmp/openrouter-api-key.XXXXXX)
    trap cleanup EXIT
    old_umask=$(umask)
    umask 077
    printf '%s\n' "$OPENROUTER_API_KEY" >"$api_key_stage_file"
    umask "$old_umask"
    api_key_mounts=(--mount "type=bind,src=$api_key_stage_file,dst=/tmp/openrouter-api-key,ro")
elif [ -n "${OPENROUTER_API_KEY_FILE:-}" ]; then
    # A relative path would be resolved inside the container, not on the host:
    # absolutize against the launcher's cwd so the mount points at the file.
    case $OPENROUTER_API_KEY_FILE in
        /*) key_file=$OPENROUTER_API_KEY_FILE ;;
        *) key_file=$(CDPATH='' cd -- "$(dirname -- "$OPENROUTER_API_KEY_FILE")" && pwd)/$(basename -- "$OPENROUTER_API_KEY_FILE") ;;
    esac
    if [ ! -f "$key_file" ]; then
        printf 'OPENROUTER_API_KEY_FILE %s is not a readable file.\n' "$key_file" >&2
        exit 1
    fi
    api_key_mounts=(--mount "type=bind,src=$key_file,dst=/tmp/openrouter-api-key,ro")
else
    printf '%s\n' 'Either OPENROUTER_API_KEY or OPENROUTER_API_KEY_FILE must be set in the environment.' >&2
    exit 1
fi

skip_pull=false
agent_args=()
for arg in "$@"; do
    if [ "$arg" = --skip-pull ]; then
        skip_pull=true
    else
        agent_args+=("$arg")
    fi
done

if [ "$skip_pull" = true ]; then
    if "$docker_bin" image inspect "$image" >/dev/null 2>&1; then
        printf 'skip-pull: using the locally available image %s.\n' "$image" >&2
    else
        printf 'Image %s not found locally; build it with ./build-docker or drop --skip-pull.\n' "$image" >&2
        exit 1
    fi
elif ! "$docker_bin" pull "$image" >&2; then
    if "$docker_bin" image inspect "$image" >/dev/null 2>&1; then
        printf 'WARNING: docker pull of %s failed (e.g. offline); continuing with the locally available image.\n' "$image" >&2
    else
        printf 'WARNING: docker pull of %s failed and no local image is available; build it with ./build-docker or retry once online.\n' "$image" >&2
        exit 1
    fi
fi

uid=$(id -u)
gid=$(id -g)

git_identity_env=()
if command -v git >/dev/null 2>&1; then
    author_name=$(git config user.name 2>/dev/null) || true
    author_email=$(git config user.email 2>/dev/null) || true
    if [ -n "$author_name" ] && [ -n "$author_email" ]; then
        printf 'Forwarding host git identity: %s <%s>\n' "$author_name" "$author_email" >&2
        git_identity_env=(
            --env "GIT_AUTHOR_NAME=$author_name"
            --env "GIT_AUTHOR_EMAIL=$author_email"
            --env "GIT_COMMITTER_NAME=$author_name"
            --env "GIT_COMMITTER_EMAIL=$author_email"
        )
    fi
fi

env_local_mounts=()
env_local_mask_file=
if [ -f "$project_dir/.env.local" ]; then
    env_local_mask_file=$(mktemp)
    printf 'Masking %s/.env.local (mounted over with an empty read-only file).\n' "$project_dir" >&2
    env_local_mounts=(--mount "type=bind,src=$env_local_mask_file,dst=$project_dir/.env.local,ro")
fi

cache_mounts=()
cache_env_overrides=()
mounted_dsts=" "
mounted_caches=

add_tool_cache() {
    local label=$1 dst=$2 env_name=$3
    local -a candidates=("${@:4}")
    local host_dir=
    if [ -n "$env_name" ]; then
        host_dir=${!env_name:-}
        case "$host_dir" in
            /*) ;;
            *) host_dir= ;;
        esac
        # An explicitly configured dir is created if missing (docker bind mounts
        # need an existing source); on failure it is dropped like an unset var.
        if [ -n "$host_dir" ] && [ ! -d "$host_dir" ]; then
            mkdir -p "$host_dir" 2>/dev/null || host_dir=
        fi
    fi
    if [ -z "$host_dir" ]; then
        # Fallback: only an already existing host default dir is shared - never
        # created (the tool then keeps its ephemeral in-container default).
        for candidate in "${candidates[@]}"; do
            if [ -d "$candidate" ]; then
                host_dir=$candidate
                break
            fi
        done
    fi
    if [ -z "$host_dir" ] || [ "$host_dir" = / ]; then
        return 0
    fi
    case "$host_dir" in
        "$project_dir"|"$project_dir"/*) return 0 ;;
    esac
    case "$mounted_dsts" in
        *" $dst "*) return 0 ;;
    esac
    cache_mounts+=(--mount "type=bind,src=$host_dir,dst=$dst")
    mounted_dsts="$mounted_dsts $dst "
    mounted_caches="$mounted_caches $label($host_dir)"
    if [ -n "$env_name" ]; then
        # Pin the tool to the mounted dir inside the container: the dst is the
        # tool's in-container default, so the value matches for existing tools.
        cache_env_overrides+=(--env "$env_name=$dst")
    fi
}

if [ "${ACP_DOCKER_MOUNT_CACHES:-1}" != 0 ]; then
    add_tool_cache uv "$container_cache_dir/uv" UV_CACHE_DIR "$host_cache_home/uv"
    add_tool_cache pip "$container_cache_dir/pip" PIP_CACHE_DIR "$host_cache_home/pip"
    add_tool_cache composer "$container_cache_dir/composer" COMPOSER_CACHE_DIR "$host_cache_home/composer"
    add_tool_cache yarn "$container_cache_dir/yarn" YARN_CACHE_FOLDER "$host_cache_home/yarn"
    add_tool_cache huggingface "$container_cache_dir/huggingface" HF_HOME "$host_cache_home/huggingface"
    add_tool_cache npm "$container_home/.npm" NPM_CONFIG_CACHE "$HOME/.npm"
    add_tool_cache gradle "$container_home/.gradle" GRADLE_USER_HOME "$HOME/.gradle"
    add_tool_cache maven "$container_home/.m2" "" "$HOME/.m2"
    add_tool_cache cargo "$container_home/.cargo" CARGO_HOME "$HOME/.cargo"
    add_tool_cache go "$container_home/go/pkg/mod" GOMODCACHE "$HOME/go/pkg/mod"
    add_tool_cache nuget "$container_home/.nuget/packages" NUGET_PACKAGES "$HOME/.nuget/packages"
    add_tool_cache pub "$container_home/.pub-cache" PUB_CACHE "$HOME/.pub-cache"
    add_tool_cache pnpm-store "$container_data_dir/pnpm/store" "" "$host_data_home/pnpm/store"
    add_tool_cache pnpm-cache "$container_cache_dir/pnpm" "" "$host_cache_home/pnpm"
    add_tool_cache konan "$container_home/.konan" KONAN_DATA_DIR "$HOME/.konan"
    if [ -n "$mounted_caches" ]; then
        printf 'Mounting host caches:%s\n' "$mounted_caches" >&2
    fi
fi

# Session state is always persisted on the host so conversations survive the
# ephemeral tmpfs home. The host side mirrors container XDG_STATE_HOME, so
# agent-side session/persist writes land in ~/.local/state/ddr-acp-agent.
# ACP_DOCKER_STATE_DIR relocates the host side (e.g. out of an fscrypt v1
# encrypted home, whose key no container can access: writes would fail with
# "Required key not available").
state_mounts=()
state_host_dir=${ACP_DOCKER_STATE_DIR:-$host_state_home/ddr-acp-agent}
case "$state_host_dir" in
    /*) ;;
    *) state_host_dir=$host_state_home/ddr-acp-agent ;;
esac
if [ -n "$state_host_dir" ] && [ "$state_host_dir" != / ] &&
   [[ "$state_host_dir" != "$project_dir" && "$state_host_dir" != "$project_dir"/* ]] &&
   ! [[ " $mounted_dsts " == *" $container_home/.local/state/ddr-acp-agent "* ]]; then
    mkdir -p "$state_host_dir" 2>/dev/null || true
    state_mounts=(--mount "type=bind,src=$state_host_dir,dst=$container_home/.local/state/ddr-acp-agent")
fi
if [ ${#state_mounts[@]} -gt 0 ]; then
    printf 'Mounting session state: %s\n' "$state_host_dir" >&2
fi

# Optional extra host paths (ACP_DOCKER_EXTRA_MOUNTS=/srv/data,/mnt/scratch:rw)
# mounted at the identical in-container path. The mode suffix defaults to ro;
# dirs and single files are allowed. Extras are emitted before every built-in
# mount and sorted shallowest-first, so built-ins and deeper extras shadow
# shallower ones (docker applies the last mount at a path on top).
extra_mount_args=()
extra_trusted_reads=
if [ -n "${ACP_DOCKER_EXTRA_MOUNTS:-}" ]; then
    extra_paths=()
    extra_modes=()
    extra_fail=false
    IFS=',' read -ra extra_entries <<<"${ACP_DOCKER_EXTRA_MOUNTS}"
    for entry in "${extra_entries[@]}"; do
        [ -n "$entry" ] || continue
        mode=ro
        path=$entry
        case $entry in
            *:ro) path=${entry%:ro} ;;
            *:rw) mode=rw; path=${entry%:rw} ;;
            *:*)
                printf 'ACP_DOCKER_EXTRA_MOUNTS: invalid entry %s (expected path, path:ro or path:rw).\n' "$entry" >&2
                extra_fail=true
                continue
                ;;
        esac
        case $path in
            /*) ;;
            *)
                printf 'ACP_DOCKER_EXTRA_MOUNTS: %s is not an absolute host path.\n' "$path" >&2
                extra_fail=true
                continue
                ;;
        esac
        if [ "$path" = / ]; then
            printf 'ACP_DOCKER_EXTRA_MOUNTS: / cannot be mounted.\n' >&2
            extra_fail=true
            continue
        fi
        if [ ! -e "$path" ]; then
            printf 'ACP_DOCKER_EXTRA_MOUNTS: %s does not exist on the host.\n' "$path" >&2
            extra_fail=true
            continue
        fi
        case $path in
            "$project_dir"|"$project_dir"/*)
                printf 'ACP_DOCKER_EXTRA_MOUNTS: skipping %s - inside the project directory, which is always mounted rw.\n' "$path" >&2
                continue
                ;;
            "$container_home"|"$container_home"/*)
                printf 'ACP_DOCKER_EXTRA_MOUNTS: skipping %s - covered by the container home.\n' "$path" >&2
                continue
                ;;
            /tmp|/tmp/*)
                printf 'ACP_DOCKER_EXTRA_MOUNTS: skipping %s - covered by the container tmpfs.\n' "$path" >&2
                continue
                ;;
        esac
        case " ${extra_paths[*]} " in
            *" $path "*)
                printf 'ACP_DOCKER_EXTRA_MOUNTS: skipping duplicate %s.\n' "$path" >&2
                continue
                ;;
        esac
        extra_paths+=("$path")
        extra_modes+=("$mode")
    done
    if [ ${#extra_paths[@]} -gt 0 ]; then
        extra_trusted_reads=$(IFS=,; printf '%s' "${extra_paths[*]}")
    fi
    if [ "$extra_fail" = true ]; then
        exit 1
    fi
    if [ ${#extra_paths[@]} -gt 0 ]; then
        declare -A extra_mode_by_path=()
        for i in "${!extra_paths[@]}"; do
            extra_mode_by_path[${extra_paths[$i]}]=${extra_modes[$i]}
        done
        mounted_extras=
        while IFS=$'\t' read -r path; do
            [ -n "$path" ] || continue
            mode=${extra_mode_by_path[$path]}
            if [ "$mode" = ro ]; then
                extra_mount_args+=(--mount "type=bind,src=$path,dst=$path,ro")
            else
                extra_mount_args+=(--mount "type=bind,src=$path,dst=$path")
            fi
            mounted_extras="$mounted_extras $path($mode)"
        done < <(for path in "${extra_paths[@]}"; do
                     printf '%s\t%s\n' "$(printf '%s' "$path" | tr -cd / | wc -c)" "$path"
                 done | LC_ALL=C sort -t "$(printf '\t')" -k1,1n -s | cut -f2)
        printf 'Mounting extra mounts:%s\n' "$mounted_extras" >&2
    fi
fi

forwarded_env=(--env "OPENROUTER_API_KEY_FILE=/tmp/openrouter-api-key")
for var_name in OPENROUTER_MODEL OPENROUTER_BASE_URL OPENROUTER_AUTO_THROUGHPUT_SORTING_ENABLED FS_PROXY_ENABLED MCP_TRUST_ANNOTATIONS ACP_BASH_TIMEOUT_SECONDS ACP_MAX_TURN_REQUESTS ACP_WEB_FETCH_ALLOW_PRIVATE; do
    if [ -n "${!var_name:-}" ]; then
        forwarded_env+=(--env "$var_name=${!var_name}")
    fi
done

rootfs_args=(--read-only)
if [ "${ACP_DOCKER_RW_ROOTFS:-}" = 1 ]; then
    rootfs_args=()
fi

# Effective extra mounts are read-trusted inside the agent (ACP_EXTRA_MOUNTS,
# see the ACP_EXTRA_MOUNTS docs): reads under them never prompt. Derived from
# the mounted extras, so skipped entries (inside the project dir / home / tmpfs)
# never widen the agent's trust domain.
if [ -n "$extra_trusted_reads" ]; then
    forwarded_env+=(--env "ACP_EXTRA_MOUNTS=$extra_trusted_reads")
fi

cap_add_args=()
if [ -n "${ACP_DOCKER_CAP_ADD:-}" ]; then
    IFS=',' read -ra caps <<<"${ACP_DOCKER_CAP_ADD}"
    for cap in "${caps[@]}"; do
        cap=${cap//[[:space:]]/}
        if [ -n "$cap" ]; then
            cap_add_args+=(--cap-add "$cap")
        fi
    done
fi

if [ -n "${ACP_DOCKER_HOME_VOLUME:-}" ]; then
    home_args=(--mount "type=volume,src=$ACP_DOCKER_HOME_VOLUME,dst=$container_home")
else
    home_args=(--tmpfs "$container_home:uid=$uid,gid=$gid,mode=700,size=1g")
fi

cache_args=(--tmpfs "$container_cache_dir:uid=$uid,gid=$gid,mode=700,size=1g")

extra_args=()
if [ -n "${ACP_DOCKER_EXTRA_ARGS:-}" ]; then
    IFS=' ' read -ra extra_args <<<"${ACP_DOCKER_EXTRA_ARGS}"
fi

# Not exec'd: the EXIT trap must run after docker returns to remove the
# staged API key file and the .env.local mask file.
"$docker_bin" run --rm --init -i \
    --network "$network" \
    --user "$uid:$gid" \
    "${api_key_mounts[@]}" \
    "${extra_mount_args[@]}" \
    --workdir "$project_dir" \
    --mount "type=bind,src=$project_dir,dst=$project_dir" \
    "${env_local_mounts[@]}" \
    "${home_args[@]}" \
    "${cache_args[@]}" \
    "${cache_mounts[@]}" \
    "${state_mounts[@]}" \
    "${rootfs_args[@]}" \
    --cap-drop=ALL \
    "${cap_add_args[@]}" \
    --security-opt no-new-privileges \
    --tmpfs /tmp:rw,nosuid,nodev,exec,size=1g \
    "${git_identity_env[@]}" \
    "${forwarded_env[@]}" \
    "${cache_env_overrides[@]}" \
    --env "HOME=$container_home" \
    --env "TERM=${TERM:-}" \
    --env "XDG_CONFIG_HOME=$container_home/.config" \
    --env "XDG_DATA_HOME=$container_home/.local/share" \
    --env "XDG_STATE_HOME=$container_home/.local/state" \
    --env "XDG_CACHE_HOME=$container_home/.cache" \
    "${extra_args[@]}" \
    "$image" \
    "${agent_args[@]}"